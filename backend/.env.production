NODE_ENV=production
PORT=5000

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=banking_db
DB_USER=banking_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# JWT Configuration - OBLIGATOIRE EN PRODUCTION
# Générez une clé sécurisée avec: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_KEY_WITH_OPENSSL
JWT_EXPIRE=8h

# CORS - Mettez à jour avec le domaine de production
CORS_ORIGIN=https://votre-domaine.com

# Auth
AUTH_RATE_LIMIT_MAX=20
PASSWORD_EXPIRY_DAYS=90

# File Processing
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.csv

# Cron Schedule
CRON_SCHEDULE=*/5 * * * *

# Timezone
TZ=Africa/Tunis

# Scan on startup
SCAN_ON_STARTUP=false

# File Scanner Configuration
MAX_FILES_PER_SCAN=100
HTTP_TIMEOUT=15000

# PAN Encryption - OBLIGATOIRE EN PRODUCTION
# Clé AES-256 pour le chiffrement des PANs en base
# Générez une clé sécurisée avec: openssl rand -base64 32
PAN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_SECURE_KEY_WITH_OPENSSL

# Redis / Queue
REDIS_URL=redis://redis:6379
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000
QUEUE_JOB_TIMEOUT=120000
QUEUE_KEEP_COMPLETE=100
QUEUE_KEEP_FAILED=50
QUEUE_MAX_PER_SECOND=5

# Pool / Scaling
DB_POOL_MAX=100
DB_BATCH_SIZE=100

# PM2
PM2_INSTANCES=max
PM2_MAX_MEMORY=512M
WORKER_INSTANCES=2
WORKER_MAX_MEMORY=512M

# Sentry (optionnel)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
