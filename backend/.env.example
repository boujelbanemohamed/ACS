NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_db
DB_USER=banking_user
DB_PASSWORD=banking_password

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=24h

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.csv

CRON_SCHEDULE=*/5 * * * *
TZ=Africa/Tunis
HTTP_TIMEOUT=15000

# CORS
CORS_ORIGIN=http://localhost:3000

# Auth
AUTH_RATE_LIMIT_MAX=10
PASSWORD_EXPIRY_DAYS=90

# Encryption (32+ caractères hex)
PAN_ENCRYPTION_KEY=your_pan_encryption_key_min_32_chars

# Sentry (optionnel)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Redis / Queue
REDIS_URL=redis://localhost:6379
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000
QUEUE_JOB_TIMEOUT=120000
QUEUE_KEEP_COMPLETE=100
QUEUE_KEEP_FAILED=50
QUEUE_MAX_PER_SECOND=5

# Pool / Scaling
DB_POOL_MAX=100
DB_BATCH_SIZE=100

# PM2
PM2_INSTANCES=max
PM2_MAX_MEMORY=512M
WORKER_INSTANCES=2
WORKER_MAX_MEMORY=512M
