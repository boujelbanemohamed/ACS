NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_db
DB_USER=banking_user
DB_PASSWORD=banking_password

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=24h

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.csv

CRON_SCHEDULE=*/5 * * * *
TZ=Africa/Tunis
HTTP_TIMEOUT=15000

# CORS
CORS_ORIGIN=http://localhost:3000

# URL publique du frontend (liens des emails de réinitialisation ; jamais déduite de l'en-tête Host)
FRONTEND_URL=http://localhost:3000

# Reverse proxy : adresses de proxy de confiance pour obtenir l'IP réelle du client
# (valeurs Express : true, false, un nombre de sauts, ou une liste ; défaut : loopback, uniquelocal)
TRUST_PROXY=

# Auth
AUTH_RATE_LIMIT_MAX=30                 # échecs de connexion par IP / 15 min
LOGIN_ACCOUNT_MAX_FAILURES=10          # échecs de connexion par compte / 15 min
PASSWORD_RESET_RATE_LIMIT_MAX=10       # demandes de réinitialisation par IP / 15 min
PASSWORD_EXPIRY_DAYS=90

# Encryption (32+ caractères hex)
PAN_ENCRYPTION_KEY=your_pan_encryption_key_min_32_chars
# Clé HMAC dédiée à l'empreinte des PAN (optionnelle, sinon dérivée de PAN_ENCRYPTION_KEY)
# Attention : la modifier invalide les empreintes existantes (recalcul nécessaire).
PAN_HASH_KEY=

# Appels sortants (process-url / call-api) : les adresses internes sont refusées.
# Liste blanche optionnelle de domaines autorisés (ils peuvent alors être internes).
ALLOWED_API_DOMAINS=
# true = autorise toute adresse interne (déconseillé)
ALLOW_PRIVATE_URLS=false

# Dossier des fichiers importés : doit être partagé entre l'API et le worker
UPLOAD_DIR=/data/uploads

# SFTP / FTP
# Empreintes SHA-256 des serveurs SFTP : "host[:port]=SHA256:xxxx,autre=SHA256:yyyy"
SFTP_HOST_FINGERPRINTS=
# true = refuse tout serveur SFTP dont l'empreinte n'est pas listée
SFTP_STRICT_HOST_KEY=false
# true = FTP sur TLS pour les URL ftp:// (ftps:// l'active toujours)
FTP_SECURE=false

# Sentry (optionnel)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Redis / Queue
REDIS_URL=redis://localhost:6379
# 1 tentative : une relance automatique après un échec partiel dupliquerait les XML envoyés à l'ACS
QUEUE_JOB_ATTEMPTS=1
QUEUE_BACKOFF_DELAY=5000
QUEUE_JOB_TIMEOUT=600000
QUEUE_KEEP_COMPLETE=100
QUEUE_KEEP_FAILED=50
QUEUE_MAX_PER_SECOND=5

# Pool / Scaling
DB_POOL_MAX=20
DB_BATCH_SIZE=100

# PM2
PM2_INSTANCES=max
PM2_MAX_MEMORY=512M
WORKER_INSTANCES=2
WORKER_MAX_MEMORY=512M
